# Email delivery for the quote/contact form (src/app/api/enquiry/route.ts).
# Without RESEND_API_KEY set, submissions are still accepted and logged
# server-side, but no email is sent. See README.md for details.

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@pushingpressure.co.uk
CONTACT_FROM_EMAIL="Pushing Pressure Website <onboarding@resend.dev>"
