# Email delivery for the quote/contact form (src/app/api/enquiry/route.ts),
# sent via Resend. Without RESEND_API_KEY set, submissions are still
# accepted and logged server-side, but no email is sent. See README.md.

RESEND_API_KEY=
CONTACT_TO_EMAIL=pushingpressureltd@outlook.com
CONTACT_FROM_EMAIL="Pushing Pressure LTD <no-reply@pushingpressureltd.com>"

# reCAPTCHA v3 (spam protection on the quote/contact form). Without
# RECAPTCHA_SECRET_KEY set, verification is skipped entirely.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: Google Search Console ownership verification meta tag.
GOOGLE_SITE_VERIFICATION=
